{
  "rewrites": [
    { "source": "/es/:path*", "destination": "/index.html" },
    { "source": "/en/:path*", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/es",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
